{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.prosperia",
    "watchPatterns": ["Dockerfile.prosperia", "railway/**"]
  },
  "deploy": {
    "startCommand": "sh -c 'bundle exec rails db:chatwoot_prepare && bundle exec rails s -b 0.0.0.0 -p ${PORT:-3000}'",
    "healthcheckPath": "/api",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
