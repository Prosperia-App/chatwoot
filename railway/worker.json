{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.prosperia",
    "watchPatterns": ["Dockerfile.prosperia", "railway/**"]
  },
  "deploy": {
    "startCommand": "bundle exec sidekiq -C config/sidekiq.yml",
    "restartPolicyType": "ALWAYS"
  }
}
